# Copy these into Netlify > Site configuration > Environment variables
# (and into a local .env.local if you ever run the site on your own machine).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudinary > Settings > Upload (unsigned preset)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# ---- Order / message email alerts (Resend, optional) ----
# Without RESEND_API_KEY the site works normally, it just doesn't send emails.
RESEND_API_KEY=re_xxxxxxxxxxxx
ORDER_NOTIFY_EMAIL=kingboost.africa@gmail.com
# Set this only after verifying your domain in Resend; it also switches on customer confirmations.
# EMAIL_FROM=KingBoostFarms <orders@kingboostfarms.com.ng>
